ADD TABLE "es-impressora"
  AREA "Dados"
  DUMP-NAME "es-impressora"

ADD FIELD "nome" OF "es-impressora" AS character 
  FORMAT "x(60)"
  INITIAL ""
  POSITION 2
  MAX-WIDTH 120
  ORDER 10
  MANDATORY

ADD FIELD "caminho" OF "es-impressora" AS character 
  FORMAT "x(200)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 400
  ORDER 20
  MANDATORY

ADD FIELD "tipo" OF "es-impressora" AS integer 
  DESCRIPTION "1 - Etiqueta
2 - Papel
3 - Cupom Fiscal"
  FORMAT ">>9"
  INITIAL "0"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY

ADD FIELD "ativa" OF "es-impressora" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  POSITION 5
  MAX-WIDTH 1
  ORDER 40

ADD INDEX "unico" ON "es-impressora" 
  AREA "Dados"
  UNIQUE
  PRIMARY
  INDEX-FIELD "nome" ASCENDING 
  INDEX-FIELD "caminho" ASCENDING 

ADD INDEX "nome" ON "es-impressora" 
  AREA "Dados"
  INDEX-FIELD "nome" ASCENDING 

ADD INDEX "tipo-ativa" ON "es-impressora" 
  AREA "Dados"
  INDEX-FIELD "tipo" ASCENDING 
  INDEX-FIELD "ativa" ASCENDING 
  INDEX-FIELD "nome" ASCENDING 

.
PSC
cpstream=ibm850
.
0000001085
